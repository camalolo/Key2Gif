<Window x:Class="Key2Gif.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key2Gif" 
        Width="480" Height="580"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated">

    <Border x:Name="RootBorder"
            Background="#E6202020"
            CornerRadius="12"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            Margin="8"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="16,14,16,8">
                <TextBox x:Name="SearchBox" 
                         Padding="10,8"
                         FontSize="14"
                         Background="#40FFFFFF"
                         Foreground="White"
                         BorderBrush="#60FFFFFF"
                         BorderThickness="1"
                         CaretBrush="White"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchBoxKeyDown">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="SearchPlaceholder" 
                           Text="Search GIFs..."
                           FontSize="14"
                           Foreground="#80FFFFFF"
                           IsHitTestVisible="False"
                           Margin="18,0,0,0"
                           Padding="0,8"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseLeftButtonUp="OnContentClick">
                <StackPanel>
                    <!-- Recent GIFs section (shown when not searching and has recent GIFs) -->
                    <StackPanel x:Name="RecentGifSection" Visibility="Collapsed">
                        <TextBlock Text="Recent GIFs" Foreground="#AAFFFFFF" FontSize="12" 
                                   Margin="16,8,16,4" FontWeight="Medium"/>
                        <WrapPanel x:Name="RecentGifPanel" Margin="8,0,8,4"/>
                    </StackPanel>

                    <!-- GIF Separator -->
                    <StackPanel x:Name="GifSeparator" Margin="16,8">
                        <Separator Background="#30FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="GifSeparatorLabel" Text="Trending GIFs" Foreground="#AAFFFFFF" FontSize="13" 
                                   HorizontalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>

                    <!-- GIF Grid (WrapPanel) -->
                    <WrapPanel x:Name="GifPanel" Margin="8,4"/>

                    <!-- Load More GIFs Button -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,8">
                        <Button x:Name="BtnLoadMore" Content="Load More GIFs" Click="OnLoadMoreGifs"
                                Padding="16,6" Background="#40FFFFFF" Foreground="White" 
                                BorderThickness="0" Margin="4" Cursor="Hand" Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#60FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Loading indicator -->
                    <TextBlock x:Name="LoadingText" Text="Loading GIFs..." 
                               Foreground="#AAFFFFFF" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,8"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
