<Window x:Class="Key2Gif.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key2Gif" 
        Width="480" Height="580"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <!-- Thin dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border x:Name="TrackBorder" Background="Transparent" CornerRadius="3"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#40FFFFFF" CornerRadius="3"
                                                        Margin="0" Width="6"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#70FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TextBox -->
        <Style TargetType="TextBox" x:Key="SearchBoxStyle">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#B0FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#305858F8"/>
                                <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E6202020"
            CornerRadius="12"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            Margin="8"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="12,12,12,6">
                <TextBox x:Name="SearchBox" 
                         Style="{StaticResource SearchBoxStyle}"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchBoxKeyDown"/>
                <TextBlock x:Name="SearchPlaceholder" 
                           Text="Search GIFs..."
                           FontSize="14"
                           Foreground="#50FFFFFF"
                           IsHitTestVisible="False"
                           Margin="24,0,0,0"
                           Padding="0,8"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseLeftButtonUp="OnContentClick"
                          PreviewMouseRightButtonUp="OnContentRightClick">
                <StackPanel>
                    <!-- Recent GIFs section -->
                    <StackPanel x:Name="RecentGifSection" Visibility="Collapsed">
                        <TextBlock Text="Recent" Foreground="#60FFFFFF" FontSize="11" 
                                   Margin="16,8,16,4" FontWeight="Normal"/>
                        <WrapPanel x:Name="RecentGifPanel" Margin="8,0,8,4"/>
                    </StackPanel>

                    <!-- GIF Separator -->
                    <StackPanel x:Name="GifSeparator" Margin="16,4,16,6">
                        <Separator Background="#15FFFFFF" Margin="0,0,0,6"/>
                        <TextBlock x:Name="GifSeparatorLabel" Text="Trending GIFs" Foreground="#60FFFFFF" FontSize="11" 
                                   HorizontalAlignment="Center" FontWeight="Normal"/>
                    </StackPanel>

                    <!-- GIF Grid -->
                    <WrapPanel x:Name="GifPanel" Margin="6,2,6,4"/>

                    <!-- Load More -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,12">
                        <Button x:Name="BtnLoadMore" Content="Load more" Click="OnLoadMoreGifs"
                                Padding="20,6" Background="#15FFFFFF" Foreground="#80FFFFFF" 
                                FontSize="12"
                                BorderThickness="0" Margin="4" Cursor="Hand" Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Loading indicator -->
                    <TextBlock x:Name="LoadingText" Text="Loading..." 
                               Foreground="#50FFFFFF" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,12"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
